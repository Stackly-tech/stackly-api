{
  "name": "stackly-api",
  "version": "1.0.0",
  "description": "This repository contains a Node.js Express application following a layered architecture. The structure is intentionally empty; you can add your implementation files later.",
  "main": "app.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "tsc",
    "test": "tsx --test --env-file=.env src/tests/search.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "plop": "plop"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/stackly-api/stackly-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "bugs": {
    "url": "https://gitlab.com/stackly-api/stackly-api/issues"
  },
  "homepage": "https://gitlab.com/stackly-api/stackly-api#readme",
